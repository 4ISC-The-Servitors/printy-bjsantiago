{
  "id": "track-ticket",
  "title": "Track a Ticket",
  "version": "1.0.0",
  "roles": ["customer"],

  "initialNode": "intro",

  "nodes": {
    "intro": {
      "id": "intro",
      "type": "message",
      "messages": [
        "Hi! I'm Printy. I can help you track your support ticket. Do you have your ticket number?"
      ],
      "quickReplies": [
        "Yes, I have a ticket number",
        "No, I need to find my ticket",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Yes, I have a ticket number",
          "targetNode": "enter_ticket_id"
        },
        {
          "label": "No, I need to find my ticket",
          "targetNode": "fetch_my_tickets"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "enter_ticket_id": {
      "id": "enter_ticket_id",
      "type": "input",
      "messages": [
        "Please enter your ticket number (e.g., TCK-000123)."
      ],
      "quickReplies": [
        "Back",
        "End Chat"
      ],
      "action": {
        "type": "validate_ticket",
        "config": {
          "inputKey": "ticket_id",
          "sanitize": "alnumdash"
        }
      },
      "transitions": [
        {
          "label": "Back",
          "targetNode": "intro"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "found"
          },
          "targetNode": "display_ticket_details"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "not_found"
          },
          "targetNode": "ticket_not_found"
        }
      ]
    },

    "display_ticket_details": {
      "id": "display_ticket_details",
      "type": "action",
      "messages": [],
      "action": {
        "type": "display_ticket_details",
        "config": {
          "ticketIdKey": "ticket_id",
          "fields": [
            "display_id",
            "inquiry_type",
            "inquiry_status",
            "received_at",
            "resolution_comments"
          ]
        }
      },
      "quickReplies": [
        "Reply to ticket",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Reply to ticket",
          "targetNode": "load_conversation"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "fetch_my_tickets": {
      "id": "fetch_my_tickets",
      "type": "action",
      "messages": [
        "Let me fetch your submitted tickets..."
      ],
      "action": {
        "type": "fetch_customer_tickets",
        "config": {
          "limit": 10,
          "requireAuth": true
        }
      },
      "quickReplies": [
        "Back",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Back",
          "targetNode": "intro"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "tickets_displayed"
          },
          "targetNode": "select_ticket_from_list"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "no_tickets"
          },
          "targetNode": "no_tickets_found"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "not_authenticated"
          },
          "targetNode": "auth_required"
        }
      ]
    },

    "select_ticket_from_list": {
      "id": "select_ticket_from_list",
      "type": "input",
      "messages": [
        "Please enter the ticket number you want to track from the list above."
      ],
      "quickReplies": [
        "Back",
        "End Chat"
      ],
      "action": {
        "type": "validate_ticket",
        "config": {
          "inputKey": "ticket_id",
          "sanitize": "alnumdash"
        }
      },
      "transitions": [
        {
          "label": "Back",
          "targetNode": "intro"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "found"
          },
          "targetNode": "display_ticket_details"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "not_found"
          },
          "targetNode": "ticket_not_found"
        }
      ]
    },

    "ticket_not_found": {
      "id": "ticket_not_found",
      "type": "message",
      "messages": [
        "I couldn't find that ticket number. Please check and try again."
      ],
      "quickReplies": [
        "Try again",
        "View my tickets",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Try again",
          "targetNode": "enter_ticket_id"
        },
        {
          "label": "View my tickets",
          "targetNode": "fetch_my_tickets"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "no_tickets_found": {
      "id": "no_tickets_found",
      "type": "message",
      "messages": [
        "You have no submitted tickets. Once you create one, I can help you track it here."
      ],
      "quickReplies": [
        "Back",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Back",
          "targetNode": "intro"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "auth_required": {
      "id": "auth_required",
      "type": "message",
      "messages": [
        "Please log in to view your submitted tickets. I can only retrieve tickets from your account."
      ],
      "quickReplies": [
        "Back",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Back",
          "targetNode": "intro"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "load_conversation": {
      "id": "load_conversation",
      "type": "action",
      "messages": [
        "Loading conversation history..."
      ],
      "action": {
        "type": "load_ticket_conversation",
        "config": {
          "inquiryIdKey": "inquiry_id",
          "createSessionIfMissing": true
        }
      },
      "quickReplies": [
        "Reply",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Reply",
          "targetNode": "reply_prompt"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "loaded"
          },
          "targetNode": "view_conversation"
        }
      ]
    },

    "view_conversation": {
      "id": "view_conversation",
      "type": "message",
      "messages": [],
      "quickReplies": [
        "Reply",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Reply",
          "targetNode": "reply_prompt"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "reply_prompt": {
      "id": "reply_prompt",
      "type": "input",
      "messages": [
        "Type your message to reply to this ticket:"
      ],
      "quickReplies": [
        "End Chat"
      ],
      "action": {
        "type": "send_ticket_reply",
        "config": {
          "sessionIdKey": "session_id",
          "messageKey": "user_input",
          "role": "user"
        }
      },
      "transitions": [
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "sent"
          },
          "targetNode": "reply_sent"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "error"
          },
          "targetNode": "reply_error"
        }
      ]
    },

    "reply_sent": {
      "id": "reply_sent",
      "type": "message",
      "messages": [
        "Your message has been sent to the admin team.",
        "They will respond as soon as possible."
      ],
      "quickReplies": [
        "Send another message",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Send another message",
          "targetNode": "reply_prompt"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "reply_error": {
      "id": "reply_error",
      "type": "message",
      "messages": [
        "Failed to send message. Please try again."
      ],
      "quickReplies": [
        "Try again",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Try again",
          "targetNode": "reply_prompt"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "end": {
      "id": "end",
      "type": "end",
      "messages": [
        "Thank you for chatting with Printy! Have a great day."
      ],
      "quickReplies": [],
      "transitions": []
    }
  }
}
