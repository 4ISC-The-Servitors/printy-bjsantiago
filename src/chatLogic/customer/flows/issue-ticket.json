{
  "id": "issue-ticket",
  "title": "Issue a Ticket",
  "version": "1.0.0",
  "roles": ["customer"],

  "initialNode": "intro",

  "nodes": {
    "intro": {
      "id": "intro",
      "type": "message",
      "messages": [
        "Hi! I'm Printy. Before we start, do you already have your order number?"
      ],
      "quickReplies": [
        "Yes, I have it",
        "I don't have it",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Yes, I have it",
          "targetNode": "enter_order_number"
        },
        {
          "label": "I don't have it",
          "targetNode": "no_order_number"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "enter_order_number": {
      "id": "enter_order_number",
      "type": "input",
      "messages": [
        "I'll help you create a support ticket. What's your order number?"
      ],
      "quickReplies": [
        "Back to Start",
        "End Chat"
      ],
      "action": {
        "type": "validate_order",
        "config": {
          "inputKey": "order_number",
          "sanitize": "alnumdash",
          "requireAuth": true,
          "profanityCheck": true
        }
      },
      "transitions": [
        {
          "label": "Back to Start",
          "targetNode": "intro"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "order_found"
          },
          "targetNode": "show_order_details"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "order_not_found"
          },
          "targetNode": "order_not_found"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "profanity_detected"
          },
          "targetNode": "profanity_warning_order"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "not_authenticated"
          },
          "targetNode": "auth_required"
        }
      ]
    },

    "profanity_warning_order": {
      "id": "profanity_warning_order",
      "type": "message",
      "messages": [
        "You have entered a flagged word.",
        "Please type a valid order number."
      ],
      "quickReplies": [
        "Try again",
        "Back to Start",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Try again",
          "targetNode": "enter_order_number"
        },
        {
          "label": "Back to Start",
          "targetNode": "intro"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "order_not_found": {
      "id": "order_not_found",
      "type": "message",
      "messages": [],
      "quickReplies": [
        "Try again",
        "Continue without order",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Try again",
          "targetNode": "enter_order_number"
        },
        {
          "label": "Continue without order",
          "targetNode": "no_order_number"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "auth_required": {
      "id": "auth_required",
      "type": "message",
      "messages": [
        "You must be signed in to view orders."
      ],
      "quickReplies": [
        "Back",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Back",
          "targetNode": "intro"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "show_order_details": {
      "id": "show_order_details",
      "type": "action",
      "messages": [
        "Is this the correct order?"
      ],
      "action": {
        "type": "display_order_details",
        "config": {
          "orderIdKey": "order_id",
          "fields": ["order_id", "order_status", "order_datetime"]
        }
      },
      "quickReplies": [
        "Yes, continue",
        "No, try again",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Yes, continue",
          "targetNode": "issue_type_menu"
        },
        {
          "label": "No, try again",
          "targetNode": "enter_order_number"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "no_order_number": {
      "id": "no_order_number",
      "type": "message",
      "messages": [
        "No problem! I can still help you create a ticket. What issue are you experiencing?"
      ],
      "quickReplies": [
        "Printing quality issue",
        "Delivery problem",
        "Billing question",
        "Other concern",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Printing quality issue",
          "targetNode": "quality_issue"
        },
        {
          "label": "Delivery problem",
          "targetNode": "delivery_issue"
        },
        {
          "label": "Billing question",
          "targetNode": "billing_issue"
        },
        {
          "label": "Other concern",
          "targetNode": "other_issue"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "issue_type_menu": {
      "id": "issue_type_menu",
      "type": "message",
      "messages": [
        "What issue are you experiencing with this order? Choose one so I can create a ticket."
      ],
      "quickReplies": [
        "Printing quality issue",
        "Delivery problem",
        "Billing question",
        "Other concern",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Printing quality issue",
          "targetNode": "quality_issue"
        },
        {
          "label": "Delivery problem",
          "targetNode": "delivery_issue"
        },
        {
          "label": "Billing question",
          "targetNode": "billing_issue"
        },
        {
          "label": "Other concern",
          "targetNode": "other_issue"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "quality_issue": {
      "id": "quality_issue",
      "type": "input",
      "messages": [
        "I understand you have a printing quality concern. Please describe the issue in detail so I can create the right ticket."
      ],
      "quickReplies": [
        "Submit ticket",
        "End Chat"
      ],
      "action": {
        "type": "collect_issue_details",
        "config": {
          "inquiry_type": "quality",
          "detailsKey": "issue_details",
          "append": true,
          "profanityCheck": true
        }
      },
      "transitions": [
        {
          "label": "Submit ticket",
          "targetNode": "submit_ticket"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "details_collected"
          },
          "targetNode": "quality_issue"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "profanity_detected"
          },
          "targetNode": "profanity_warning_details"
        }
      ]
    },

    "delivery_issue": {
      "id": "delivery_issue",
      "type": "input",
      "messages": [
        "I'm sorry to hear about the delivery issue. Please provide details about what happened."
      ],
      "quickReplies": [
        "Submit ticket",
        "End Chat"
      ],
      "action": {
        "type": "collect_issue_details",
        "config": {
          "inquiry_type": "delivery",
          "detailsKey": "issue_details",
          "append": true,
          "profanityCheck": true
        }
      },
      "transitions": [
        {
          "label": "Submit ticket",
          "targetNode": "submit_ticket"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "details_collected"
          },
          "targetNode": "delivery_issue"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "profanity_detected"
          },
          "targetNode": "profanity_warning_details"
        }
      ]
    },

    "billing_issue": {
      "id": "billing_issue",
      "type": "input",
      "messages": [
        "I can help with your billing concern. Please describe the issue you're experiencing."
      ],
      "quickReplies": [
        "Submit ticket",
        "End Chat"
      ],
      "action": {
        "type": "collect_issue_details",
        "config": {
          "inquiry_type": "billing",
          "detailsKey": "issue_details",
          "append": true,
          "profanityCheck": true
        }
      },
      "transitions": [
        {
          "label": "Submit ticket",
          "targetNode": "submit_ticket"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "details_collected"
          },
          "targetNode": "billing_issue"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "profanity_detected"
          },
          "targetNode": "profanity_warning_details"
        }
      ]
    },

    "other_issue": {
      "id": "other_issue",
      "type": "input",
      "messages": [
        "I'm here to help with any other concerns you may have. Please describe the issue."
      ],
      "quickReplies": [
        "Submit ticket",
        "End Chat"
      ],
      "action": {
        "type": "collect_issue_details",
        "config": {
          "inquiry_type": "other",
          "detailsKey": "issue_details",
          "append": true,
          "profanityCheck": true
        }
      },
      "transitions": [
        {
          "label": "Submit ticket",
          "targetNode": "submit_ticket"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "details_collected"
          },
          "targetNode": "other_issue"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "profanity_detected"
          },
          "targetNode": "profanity_warning_details"
        }
      ]
    },

    "profanity_warning_details": {
      "id": "profanity_warning_details",
      "type": "message",
      "messages": [
        "You have entered a flagged word.",
        "Please rephrase your description."
      ],
      "quickReplies": [
        "Try again",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Try again",
          "targetNode": "OTHER_ISSUE_NODE"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "submit_ticket": {
      "id": "submit_ticket",
      "type": "action",
      "messages": [
        "Thank you for providing the details. I'm creating your support ticket..."
      ],
      "action": {
        "type": "create_inquiry_with_turnstile",
        "config": {
          "messageKey": "issue_details",
          "inquiryTypeKey": "inquiry_type",
          "turnstileAction": "issue_ticket_submit"
        }
      },
      "quickReplies": [
        "End Chat"
      ],
      "transitions": [
        {
          "condition": {
            "type": "action_result",
            "value": "success"
          },
          "targetNode": "ticket_created"
        },
        {
          "condition": {
            "type": "action_result",
            "value": "error"
          },
          "targetNode": "ticket_error"
        }
      ]
    },

    "ticket_created": {
      "id": "ticket_created",
      "type": "message",
      "messages": [
        "Ticket submitted successfully!"
      ],
      "quickReplies": [
        "End Chat"
      ],
      "transitions": [
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "ticket_error": {
      "id": "ticket_error",
      "type": "message",
      "messages": [
        "Couldn't create the ticket. Try again later."
      ],
      "quickReplies": [
        "Try again",
        "End Chat"
      ],
      "transitions": [
        {
          "label": "Try again",
          "targetNode": "submit_ticket"
        },
        {
          "label": "End Chat",
          "targetNode": "end"
        }
      ]
    },

    "end": {
      "id": "end",
      "type": "end",
      "messages": [
        "Thank you for chatting with Printy! Have a great day."
      ],
      "quickReplies": [],
      "transitions": []
    }
  }
}
